{
    "path-intellisense.mappings": {
        "/": "${workspaceFolder}",
        "~": "${workspaceFolder}"
    },
    "path-intellisense.autoSlashAfterDirectory": true,
    "path-intellisense.extensionOnImport": true,
    "path-intellisense.showHiddenFiles": true,
    "path-intellisense.absolutePathToWorkspace": true,
    "r.lsp.enabled": true,
    "r.lsp.diagnostics": true,
    "r.lsp.completion": true,
    "r.lsp.signatureHelp": true,
    "r.lsp.hover": true,
    "r.lsp.workspaceSymbolProvider": true,
    "r.lsp.documentSymbolProvider": true,
    "r.lsp.documentFormattingProvider": true,
    "r.lsp.documentRangeFormattingProvider": true,
    "r.lsp.documentOnTypeFormattingProvider": true,
    "r.lsp.foldingRangeProvider": true,
    "r.lsp.selectionRangeProvider": true,
    "r.lsp.callHierarchyProvider": true,
    "r.lsp.semanticTokensProvider": true,
    "r.lsp.inlayHintProvider": true,
    "r.lsp.codeActionProvider": true,
    "r.lsp.codeLensProvider": true,
    "r.lsp.renameProvider": true,
    "r.lsp.referencesProvider": true,
    "r.lsp.implementationProvider": true,
    "r.lsp.definitionProvider": true,
    "r.lsp.typeDefinitionProvider": true,
    "r.lsp.documentHighlightProvider": true,
    "r.lsp.documentLinkProvider": true,
    "r.lsp.executeCommandProvider": true,
    "r.lsp.workspaceFolder": true,
    "r.lsp.useGlobalR": true,
    "r.lsp.rterm.windows": "radian",
    "r.lsp.rterm.linux": "radian",
    "r.lsp.rterm.osx": "radian"
}
